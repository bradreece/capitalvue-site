# Source only. Netlify runs `node build.js` on every push and publishes the
# result, so generated output is not committed. Everything below the first
# rule is written by build.js. Source lives in build.js, content/, assets/,
# netlify/, the *.src.* files and the docs. (Convention set 21 Oct 2026; the
# tracked-output rule it replaces dated from before the Netlify build step.)

# Generated by build.js
/*.html
/style.css
/sitemap.xml
/robots.txt
/ai.txt
/llms.txt
/_redirects
/_headers
/snapshot-email.js

node_modules/
.netlify/
.DS_Store
Thumbs.db
*.log
npm-debug.log*

# Never commit. These leaked onto the live site once already.
_private/
*.env
.env*
!.env.example

# Local scratch
tmp/
scratch/
*.zip
